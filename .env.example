# BindForge — copy to `.env` and fill in the keys you use.
# None of these are required for --dry-run (mock providers).

# NVIDIA NIM hosted Boltz-2 (structure prediction)
# Get a key at https://build.nvidia.com/mit/boltz2
NVIDIA_API_KEY=

# boltz.bio (BoltzGen de novo binder design + Boltz-2 prediction)
# Get a key at https://boltz.bio
BOLTZ_BIO_API_KEY=

# Chai-1 (reserved — no official programmatic API yet)
CHAI_API_KEY=

# --- MD defaults (override per-run with CLI flags) ---
BINDFORGE_MD_SOLVENT=implicit
BINDFORGE_MD_NS=5.0
BINDFORGE_MD_TEMP=300.0
BINDFORGE_MD_DT=2.0
BINDFORGE_MD_PLATFORM=auto

# Where results are written
BINDFORGE_RESULTS_DIR=results
